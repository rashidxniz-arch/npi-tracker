rules_version = '2';
// NPI Tracker Firestore rules — v2.12.
// Before deploying: every users/{uid} document needs teamKey (e.g. "fadzmi"); see docs/DEPLOYMENT.md.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function activeUser() { return signedIn() && userDoc().data.active == true; }
    function role() { return userDoc().data.get('role', 'member'); }
    function admin() { return activeUser() && role() == 'admin'; }
    function engineer() { return activeUser() && role() in ['admin', 'engineer']; }
    // Viewers can read everything but write nothing.
    function writer() { return activeUser() && role() in ['admin', 'engineer', 'member']; }
    function teamKey(k) { return k in ['rashid','fadzmi','liyana','yusri','zul','fakrul','wajdi','shamsuri']; }
    // The team key recorded on the signed-in user's profile. Writes must be made as yourself.
    function myKey() { return userDoc().data.get('teamKey', ''); }
    function isMe(k) { return teamKey(k) && k == myKey(); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update, delete: if admin();
    }
    match /projects/{id} {
      allow read: if activeUser();
      allow create, update, delete: if engineer();
    }
    match /tasks/{id} {
      allow read: if activeUser();
      allow create: if writer()
        && request.resource.data.source == 'google-sheets'
        && request.resource.data.createdByUid == request.auth.uid
        && isMe(request.resource.data.createdBy)
        && teamKey(request.resource.data.owner)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200;
      allow update: if writer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner','updatedAt','updatedBy','updatedByUid'])
        && teamKey(request.resource.data.owner)
        && request.resource.data.updatedByUid == request.auth.uid
        && isMe(request.resource.data.updatedBy);
      // Team tasks can be removed by the person who added them or the owner; admins can remove any.
      allow delete: if admin() || (writer() && resource.data.source == 'google-sheets'
        && (resource.data.createdByUid == request.auth.uid || resource.data.owner == myKey()));
    }
    match /status/{id} {
      allow read: if activeUser();
      allow create, update: if writer()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.id == id
        && request.resource.data.done is bool
        && isMe(request.resource.data.by);
      allow delete: if false;
    }
    match /updates/{id} {
      allow read: if activeUser();
      allow create: if writer()
        && request.resource.data.createdByUid == request.auth.uid
        && isMe(request.resource.data.owner)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 600;
      allow update, delete: if admin();
    }
    match /meetings/{id} {
      allow read: if activeUser();
      allow create, update, delete: if engineer();
    }
    match /workload/{id} {
      allow read: if activeUser();
      allow create, update: if writer()
        && request.resource.data.actorUid == request.auth.uid
        && isMe(request.resource.data.by)
        && request.resource.data.hours is number
        && request.resource.data.hours >= 0
        && request.resource.data.hours <= 200;
      allow delete: if admin();
    }
    match /team/{id} {
      allow read: if activeUser();
      allow create, update, delete: if admin();
    }
    match /migrationRuns/{id} { allow read, write: if admin(); }

    // Legacy flat snapshot collections (read by app v2.11 and earlier; still mirrored by the publisher).
    match /emailSnapshotProjects/{id} { allow read: if activeUser(); allow create, update, delete: if admin(); }
    match /emailSnapshotActions/{id} { allow read: if activeUser(); allow create, update, delete: if admin(); }
    match /emailSnapshotEvidence/{id} { allow read: if activeUser(); allow create, update, delete: if admin(); }
    // Pointer to the live snapshot version. Changed only by an admin (publish or rollback transaction).
    match /emailSnapshotMeta/{id} { allow read: if activeUser(); allow create, update: if admin(); allow delete: if false; }

    // Versioned snapshots: records can only be added while a version is staging, and are never edited or deleted.
    match /emailSnapshots/{version} {
      allow read: if activeUser();
      allow create: if admin() && request.resource.data.status == 'staging';
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','publishedAt','publishedBy','error'])
        && request.resource.data.status in ['published','superseded','failed']
        // A failed version (possibly incomplete) can never be made live.
        && (request.resource.data.status != 'published' || resource.data.status in ['staging','published','superseded']);
      allow delete: if false;
      match /{kind}/{recordId} {
        allow read: if activeUser();
        allow create: if admin()
          && kind in ['projects','actions','evidence']
          && get(/databases/$(database)/documents/emailSnapshots/$(version)).data.status == 'staging';
        allow update, delete: if false;
      }
    }

    match /auditLogs/{id} {
      allow read: if admin();
      allow create: if writer()
        && request.resource.data.actorUid == request.auth.uid
        && isMe(request.resource.data.actor)
        && request.resource.data.action is string;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
